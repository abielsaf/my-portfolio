---
// Real contribution heatmap from Ángel's PRs to commonwealth-ga-server, baked in
// at build time — no runtime/API dependency. Window and caption both derive from
// the data, so refreshing src/data/contributions.ts is the only step needed.
import { prActivity } from '../data/contributions';

const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;

const dates = Object.keys(prActivity).sort();
const total = Object.values(prActivity).reduce((a, b) => a + b, 0);

// Window derives from the data, not a hardcoded anchor. End = last activity
// rolled forward to Saturday; the view then extends back far enough to cover the
// first activity, with a 14-week floor so short streaks don't render as a stub.
const DAY = 24 * 60 * 60 * 1000;
const end = new Date(`${dates[dates.length - 1]}T00:00:00Z`);
end.setUTCDate(end.getUTCDate() + (6 - end.getUTCDay()));

const firstSunday = new Date(`${dates[0]}T00:00:00Z`);
firstSunday.setUTCDate(firstSunday.getUTCDate() - firstSunday.getUTCDay());

const WEEKS = Math.max(14, (end.getTime() - firstSunday.getTime()) / (7 * DAY) + 1);

const start = new Date(end);
start.setUTCDate(start.getUTCDate() - (WEEKS * 7 - 1));

// e.g. "Jun–Jul 2026", or "Jul 2026" when it all falls in one month.
const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    timeZone: 'UTC',
  });
const firstMonth = fmt(dates[0]);
const lastMonth = fmt(dates[dates.length - 1]);
const year = dates[dates.length - 1].slice(0, 4);
const period =
  firstMonth === lastMonth
    ? `${firstMonth} ${year}`
    : `${firstMonth}–${lastMonth} ${year}`;

// Neutral grey for empty days reads on both themes; white at 6% vanished on light.
const colors = ['rgba(127,127,127,0.18)', '#0e4429', '#26a641', '#39d353'];
const levelFor = (count: number): number =>
  count <= 0 ? 0 : count === 1 ? 1 : count === 2 ? 2 : 3;

type Cell = { x: number; y: number; level: number; date: string; count: number };
const cells: Cell[] = [];
const cursor = new Date(start);
for (let w = 0; w < WEEKS; w++) {
  for (let d = 0; d < 7; d++) {
    const iso = cursor.toISOString().slice(0, 10);
    const count = prActivity[iso] ?? 0;
    cells.push({ x: w * STEP, y: d * STEP, level: levelFor(count), date: iso, count });
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }
}

const width = WEEKS * STEP - GAP;
const height = 7 * STEP - GAP;
---

<figure class="contrib">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    role="img"
    aria-label={`${total} pull requests to commonwealth-ga-server, ${period}`}
  >
    {cells.map((c) => (
      <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="2" ry="2" fill={colors[c.level]}>
        {c.count > 0 && <title>{`${c.count} PR${c.count > 1 ? 's' : ''} · ${c.date}`}</title>}
      </rect>
    ))}
  </svg>
  <figcaption>{total} pull requests · {period}</figcaption>
</figure>

<style>
  .contrib {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    width: 100%;
    height: 100%;
  }
  /* Fills whatever box the card gives it; the viewBox keeps cells square, so it
     grows until either the width or the height runs out. */
  .contrib svg {
    width: 100%;
    max-height: 100%;
    height: auto;
  }
  .contrib figcaption {
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #475569;
  }
  :global(.dark) .contrib figcaption {
    color: #94a3b8;
  }
</style>
