---
import { useTranslations } from "../i18n/utils";
import { mergedPRs } from "../data/contributions";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const skills = {
  frontend: ["React", "TypeScript", "JavaScript", "Astro", "Tailwind CSS"],
  backend: ["Python", "Node.js", "Flask", "RESTful APIs", "PostgreSQL"],
  tools: ["Git", "Bash", "Postman", "Jest", "Vercel", "Figma"],
};

// Tech shown on the project cards that isn't already in `skills` above. Keep in
// sync with Projects.astro; counted so the stat below can't drift from the page.
const projectOnlyTech = [
  "Zustand",
  "Vite",
  "C / C++",
  "Game server RE",
  "TCP/UDP networking",
];

const techCount = new Set([...Object.values(skills).flat(), ...projectOnlyTech])
  .size;
---

<section id="about" class="about-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="about-title">{t("about.title")}</h2>
      <div class="about-divider"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- About content -->
      <div class="space-y-6">
        <p class="about-description">{t("about.description")}</p>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mt-8">
          <div class="about-stat">
            <div class="about-stat-number text-primary-500">3+</div>
            <div class="about-stat-label">{t("about.experience")}</div>
          </div>
          <div class="about-stat">
            <div class="about-stat-number text-accent-500">{mergedPRs}</div>
            <div class="about-stat-label">{t("about.merged")}</div>
          </div>
          <div class="about-stat">
            <div class="about-stat-number text-primary-500">{techCount}</div>
            <div class="about-stat-label">{t("about.technologies")}</div>
          </div>
        </div>
      </div>

      <!-- Skills -->
      <div class="space-y-8">
        <!-- Frontend Skills -->
        <div>
          <h3 class="skill-heading">
            <svg
              class="skill-icon text-primary-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"
              ></path>
            </svg>
            {t("skills.frontend")}
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              skills.frontend.map((skill) => (
                <span class="skill-badge skill-frontend">{skill}</span>
              ))
            }
          </div>
        </div>

        <!-- Backend Skills -->
        <div>
          <h3 class="skill-heading">
            <svg
              class="skill-icon text-accent-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3m16.5 0h.008v.008h-.008v-.008Zm-3 0h.008v.008h-.008v-.008Z"
              ></path>
            </svg>
            {t("skills.backend")}
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              skills.backend.map((skill) => (
                <span class="skill-badge skill-backend">{skill}</span>
              ))
            }
          </div>
        </div>

        <!-- Tools -->
        <div>
          <h3 class="skill-heading">
            <svg
              class="skill-icon text-primary-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.25 5.25a2.652 2.652 0 0 0-3.75 3.75l5.877 5.877"
              ></path>
            </svg>
            {t("skills.tools")}
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              skills.tools.map((skill) => (
                <span class="skill-badge skill-tools">{skill}</span>
              ))
            }
          </div>
        </div>
        <!-- 🌍 Languages -->
        <div>
          <h3 class="skill-heading">
            <svg class="skill-icon invisible"></svg>
            <!-- hidden icon space to align heading -->
            {t("skills.languages")}
          </h3>

          <div class="space-y-2 mt-2 pl-1">
            <!-- Spanish -->
            <div class="grid grid-cols-[80px_1fr] items-center">
              <span class="font-medium text-gray-800 dark:text-white">
                {t("skills.languages.es")}:
              </span>
              <div class="flex gap-1">
                {
                  [...Array(5)].map(() => (
                    <span class="w-4 h-4 rounded-full bg-primary-500 border border-gray-300 dark:border-transparent" />
                  ))
                }
              </div>
            </div>

            <!-- English -->
            <div class="grid grid-cols-[80px_1fr] items-center">
              <span class="font-medium text-gray-800 dark:text-white">
                {t("skills.languages.en")}:
              </span>
              <div class="flex gap-1">
                {
                  [1, 2, 3, 4, 5].map((i) => (
                    <span
                      class={`w-4 h-4 rounded-full ${
                        i <= 4
                          ? "bg-primary-500"
                          : "bg-gray-400 dark:bg-gray-600"
                      } border border-gray-300 dark:border-transparent`}
                    />
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
