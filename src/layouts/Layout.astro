---
export interface Props {
  title: string;
  lang?: "es" | "en";
}
const { title, lang = "es" } = Astro.props;
import { ThemeScript } from "astro-theme-toggle";
import '../styles/base.css';
import Analytics from '@vercel/analytics/astro';

const description =
  lang === "es"
    ? "Portfolio de Ángel Bielsa — Desarrollador Full Stack en Madrid, especializado en React, TypeScript, Python y Astro."
    : "Ángel Bielsa Portfolio — Full Stack Developer based in Madrid, specialized in React, TypeScript, Python and Astro.";

// Both locales are hand-authored routes: es at /, en at /en/.
const pathFor = { es: "/", en: "/en/" } as const;
const canonical = new URL(pathFor[lang], Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ángel Bielsa",
  url: Astro.site?.href,
  image: ogImage.href,
  jobTitle: lang === "es" ? "Desarrollador Full Stack" : "Full Stack Developer",
  email: "mailto:bielsafuentes@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Madrid",
    addressCountry: "ES",
  },
  knowsLanguage: ["es", "en"],
  sameAs: [
    "https://github.com/abielsaf",
    "https://www.linkedin.com/in/angelbielsa/",
  ],
  knowsAbout: [
    "React", "TypeScript", "JavaScript", "Astro", "Tailwind CSS",
    "Python", "Node.js", "Flask", "PostgreSQL",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Ángel Bielsa" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <ThemeScript />

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="es" href={new URL("/", Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Ángel Bielsa" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_ES"}
    />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={lang === "es"
        ? "Ángel Bielsa — Desarrollador Full Stack"
        : "Ángel Bielsa — Full Stack Developer"}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body class="antialiased transition-colors duration-300">
    <div
      id="lang-loading-overlay"
      class="fixed inset-0 bg-white dark:bg-dark-900/90 flex items-center justify-center z-[9999] hidden transition-opacity duration-300"
    >
      <div
        class="w-10 h-10 border-4 border-primary-400 border-t-transparent rounded-full animate-spin"
      >
      </div>
    </div>
    <slot />
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        if (sessionStorage.getItem("disableAnimations") === "true") {
          document
            .querySelectorAll(".animate-fade-in, .animate-slide-up")
            .forEach((el) => {
              el.classList.remove("animate-fade-in", "animate-slide-up");
            });
          sessionStorage.removeItem("disableAnimations");
        }
      });
    </script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        document.body.classList.add("loaded");
      });
    </script>
    <Analytics />
  </body>
</html>
